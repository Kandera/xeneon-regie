{
  "author": "Kandera",
  "id": "app.kandera.regie",
  "name": "Regie",
  "description": "Eigener Twitch-Chat, nur lesen. Quick Actions, Stats und Aktivität auf dem XENEON EDGE.",
  "version": "0.1.1",
  "preview_icon": "resources/icon.svg",
  "min_framework_version": "1.0.0",
  "min_app_version": "5.47",
  "os": [{ "platform": "windows" }],
  "supported_devices": [{ "type": "dashboard_lcd" }],
  "interactive": true,
  "required_plugins": ["widgetbuilder.linkprovider:Url:1.0"],
  "permissions": [
    { "type": "url", "domain": "twitch.tv" },
    { "type": "url", "domain": "jtvnw.net" }
  ]
}
